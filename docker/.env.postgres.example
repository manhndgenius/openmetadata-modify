# Images. OM_SERVER_IMAGE must contain this repository's customized UI.
OM_SERVER_IMAGE=your-registry/openmetadata-server:1.12.13-dq
DQ_BACKEND_IMAGE=your-registry/dq-rule-backend:1.0.0

# Fresh full-stack PostgreSQL database created by docker/docker-compose.yml.
DB_DRIVER_CLASS=org.postgresql.Driver
DB_SCHEME=postgresql
DB_HOST=postgresql
DB_PORT=5432
DB_USER=openmetadata_user
DB_USER_PASSWORD=openmetadata_password
OM_DATABASE=openmetadata_db
DB_USE_SSL=false
DB_PARAMS=sslmode=disable
POSTGRES_SUPERUSER_PASSWORD=password
POSTGRES_PORT_PUBLISHED=5432

# DQ reuses the DB_HOST/DB_PORT/DB_USER/DB_USER_PASSWORD/OM_DATABASE values
# above and persists only its own prefixed tables in that database.
DQ_DB_SSLMODE=disable

# OpenMetadata API access used by the DQ backend.
BOT_TOKEN=replace-with-openmetadata-bot-jwt
DQ_OM_API=http://openmetadata-server:8585

# OpenAI-compatible LLM endpoint used for Advanced rule generation.
LLM_API=ollama
LLM_BASE_URL=http://your-llm-host:11434/v1
LLM_MODEL=gemma4-e2b
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=8192

# Public browser origin(s), comma-separated. Do not append a path.
DQ_CORS_ORIGINS=https://openmetadata.example.com
DQ_API_PORT=8000

# Airflow may use a different database/user on the same PostgreSQL server.
AIRFLOW_DB_HOST=postgresql
AIRFLOW_DB_PORT=5432
AIRFLOW_DB=airflow_db
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=replace-with-airflow-password
